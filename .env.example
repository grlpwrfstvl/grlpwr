# Public Sanity project config (safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=59jzk62a
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token: enables draft preview / Presentation tool (sanity.io/manage → API → Tokens, "Viewer")
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity publish webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Editor token, only needed locally to run scripts/migrate-2027.mjs
SANITY_WRITE_TOKEN=

# Formspree form id for the contact form
NEXT_PUBLIC_FORMSPREE_ID=xayrnklv
